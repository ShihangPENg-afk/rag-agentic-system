# 模板文件：仅放占位符，真实 Key 请写入 .env（不要改本文件）
# 首次初始化: make env-init
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# embedding provider: dashscope(默认) 或 fake(测试/离线)
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL_NAME=text-embedding-v1

# rerank provider: mock(默认，离线/测试可用) 或 none
RERANK_PROVIDER=mock

# RAG 低置信度阈值；默认 0 表示不拦截正常回答
RAG_MIN_CONFIDENCE=0.0

# OpenAI-compatible endpoint for DashScope
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM provider: dashscope(默认) 或 local(本地 OpenAI-compatible 服务 / 占位)
LLM_PROVIDER=dashscope

# 默认模型名称，可根据需要调整
MODEL_NAME=qwen-plus

# local provider 占位配置；未配置真实模型时可用 LOCAL_LLM_MOCK=true 返回 mock response
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
LOCAL_LLM_MOCK=false

# Ollama 本地模型接入示例；LLM_PROVIDER=local 且未配置 LOCAL_LLM_* 时使用
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# PostgreSQL（混合持久化元数据 / 问答日志）
POSTGRES_USER=rag_agent_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag_agent_db
# 本地直连 Postgres 时使用 localhost；Docker Compose 内由 compose 覆盖为 postgres 主机名
DATABASE_URL=postgresql+psycopg2://rag_agent_user:change-me@localhost:5432/rag_agent_db

HEALTH_API_URL=http://127.0.0.1:8010
HEALTH_API_TIMEOUT=5
# 默认 http：maintenance_agent 优先调用 predictive-maintenance-mini /predict；服务不可用时自动 mock fallback
MAINTENANCE_HEALTH_PROVIDER=http

# Redis（用于 chat 接口限流）
REDIS_URL=redis://localhost:6379/0

# JWT 认证
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
