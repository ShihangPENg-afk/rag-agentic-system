# 模板文件：仅放占位符，真实 Key 请写入 .env（不要改本文件）
# 首次初始化: make env-init
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# embedding provider: dashscope(默认) 或 fake(测试/离线)
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL_NAME=text-embedding-v1

# OpenAI-compatible endpoint for DashScope
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认模型名称，可根据需要调整
MODEL_NAME=qwen-plus

# PostgreSQL（混合持久化元数据 / 问答日志）
POSTGRES_USER=rag_agent_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag_agent_db
# 本地直连 Postgres 时使用 localhost；Docker Compose 内由 compose 覆盖为 postgres 主机名
DATABASE_URL=postgresql+psycopg2://rag_agent_user:change-me@localhost:5432/rag_agent_db

HEALTH_API_URL=http://127.0.0.1:8010

# Redis（用于 chat 接口限流）
REDIS_URL=redis://localhost:6379/0

# JWT 认证
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
